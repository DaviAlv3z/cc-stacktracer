{
  "name": "cc-stacktracer",
  "version": "3.3.0-rc.1",
  "description": "Observability SDK for Node.js — captures errors, structured logs, distributed traces and database spans, and ships them to a CC StackTracer ingestion API.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "//redisMemoryServer": "O postinstall da lib compila o Redis do source, e a tag `stable` que ela baixa passou a trazer RediSearch/RedisJSON/RedisTimeSeries — cujo build exige um toolchain que nem o runner do CI nem as imagens Docker tem. Resultado: `npm ci` falhava em todo lugar. Ela e devDependency do ingestion-api e serve apenas ao script local `npm run redis:dev`, que baixa o binario sob demanda na primeira execucao. Desligar o postinstall nao tira funcionalidade nenhuma.",
  "redisMemoryServer": {
    "disablePostinstall": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "AGENTS.md",
    "docs/client-installation-integration-playbook.md",
    "docs/client-payload-quality-checklist.md",
    "docs/client-node-tgz-installation.md",
    "docs/client-generic-http-node.md",
    "docs/client-universal-https-ingestion.md",
    "docs/client-onboarding-troubleshooting.md",
    "docs/client-distributed-tracing.md",
    "docs/guides/agents.md",
    "docs/guides/subtenant.md",
    "docs/guides/integration-adonis.md",
    "docs/guides/integration-adonis.en-US.md",
    "docs/guides/integration-nestjs.md",
    "docs/guides/integration-nestjs.en-US.md",
    "cursor-rules"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fastify": {
      "types": "./dist/integrations/fastify.d.ts",
      "import": "./dist/integrations/fastify.js",
      "default": "./dist/integrations/fastify.js"
    },
    "./express": {
      "types": "./dist/integrations/express.d.ts",
      "import": "./dist/integrations/express.js",
      "default": "./dist/integrations/express.js"
    },
    "./adonis": {
      "types": "./dist/integrations/adonis.d.ts",
      "import": "./dist/integrations/adonis.js",
      "default": "./dist/integrations/adonis.js"
    },
    "./adonis/middleware": {
      "types": "./dist/integrations/adonis-middleware.d.ts",
      "import": "./dist/integrations/adonis-middleware.js",
      "default": "./dist/integrations/adonis-middleware.js"
    },
    "./generic-http": {
      "types": "./dist/generic-http/index.d.ts",
      "import": "./dist/generic-http/index.js",
      "default": "./dist/generic-http/index.js"
    },
    "./db-prisma": {
      "types": "./dist/db/prisma.d.ts",
      "import": "./dist/db/prisma.js",
      "default": "./dist/db/prisma.js"
    },
    "./db-lucid": {
      "types": "./dist/db/lucid.d.ts",
      "import": "./dist/db/lucid.js",
      "default": "./dist/db/lucid.js"
    },
    "./plugin-sdk": {
      "types": "./dist/plugin-sdk.d.ts",
      "import": "./dist/plugin-sdk.js",
      "default": "./dist/plugin-sdk.js"
    }
  },
  "typesVersions": {
    "*": {
      "fastify": [
        "./dist/integrations/fastify.d.ts"
      ],
      "express": [
        "./dist/integrations/express.d.ts"
      ],
      "adonis": [
        "./dist/integrations/adonis.d.ts"
      ],
      "adonis/middleware": [
        "./dist/integrations/adonis-middleware.d.ts"
      ],
      "generic-http": [
        "./dist/generic-http/index.d.ts"
      ],
      "db-prisma": [
        "./dist/db/prisma.d.ts"
      ],
      "db-lucid": [
        "./dist/db/lucid.d.ts"
      ],
      "plugin-sdk": [
        "./dist/plugin-sdk.d.ts"
      ]
    }
  },
  "bin": {
    "cc-stacktracer": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:client": "tsc -p tsconfig.build.json",
    "pack:client": "npm run build:client && npm pack",
    "pack:client:dry": "npm run build:client && npm pack --dry-run",
    "test": "vitest run --dir src",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"*.{md,json}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "observability",
    "apm",
    "tracing",
    "distributed-tracing",
    "opentelemetry",
    "spans",
    "telemetry",
    "error-tracking",
    "error-monitoring",
    "logging",
    "structured-logging",
    "stacktrace",
    "monitoring",
    "nodejs",
    "typescript",
    "fastify",
    "express",
    "adonisjs",
    "prisma",
    "clickhouse"
  ],
  "peerDependencies": {
    "@adonisjs/core": ">=6.0.0",
    "@adonisjs/lucid": ">=20.0.0",
    "@prisma/client": ">=5.0.0",
    "express": ">=4.0.0 || >=5.0.0",
    "fastify": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/core": {
      "optional": true
    },
    "@adonisjs/lucid": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adonisjs/core": "^7.3.3",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.1.0",
    "express": "^5.2.1",
    "fastify": "^5.8.5",
    "prettier": "3.8.1",
    "supertest": "^7.2.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.57.1",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaviAlv3z/cc-stacktracer.git"
  },
  "author": "Davi Alves",
  "bugs": {
    "url": "https://github.com/DaviAlv3z/cc-stacktracer/issues"
  },
  "homepage": "https://github.com/DaviAlv3z/cc-stacktracer#readme",
  "publishConfig": {
    "access": "public"
  }
}
